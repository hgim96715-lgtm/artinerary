generator client {
    provider     = "prisma-client"
    output       = "../generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// Exhibitions

enum Role {
    ADMIN
    USER
}

enum ExhibitionSource {
    MANUAL
    API
}

enum ExhibitionFeeType {
    FREE
    PAID
    UNKNOWN
}

model Exhibition {
    id           Int               @id @default(autoincrement())
    source       ExhibitionSource  @default(MANUAL)
    externalId   String?
    apiProvider  String?
    title        String
    description  String?
    imageUrl     String?
    sourceUrl    String?
    startDate    DateTime
    endDate      DateTime
    priceText    String?
    discountText String?
    feeType      ExhibitionFeeType @default(UNKNOWN)

    venueName String?
    area      String?
    address   String?
    latitude  Float?
    longitude Float?
    isVisible Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([apiProvider, externalId])
}

model User {
    id           Int      @id @default(autoincrement())
    email        String   @unique
    nickname     String   @unique
    passwordHash String
    role         Role     @default(USER)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}
