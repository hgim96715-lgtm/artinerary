generator client {
    provider     = "prisma-client"
    output       = "../generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// Exhibitions

enum Role {
    ADMIN
    USER
}

enum ExhibitionSource {
    MANUAL
    API
}

enum ExhibitionFeeType {
    FREE
    PAID
    UNKNOWN
}

model Exhibition {
    id           Int               @id @default(autoincrement())
    source       ExhibitionSource  @default(MANUAL)
    externalId   String?
    apiProvider  String?
    title        String
    description  String?
    imageUrl     String?
    sourceUrl    String?
    startDate    DateTime
    endDate      DateTime
    priceText    String?
    discountText String?
    feeType      ExhibitionFeeType @default(UNKNOWN)

    venueName    String?
    area         String?
    address      String?
    latitude     Float?
    longitude    Float?
    isVisible    Boolean       @default(true)
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    wishlists    Wishlist[]
    visitRecords VisitRecord[]

    @@unique([apiProvider, externalId])
}

model User {
    id           Int           @id @default(autoincrement())
    email        String        @unique
    nickname     String        @unique
    passwordHash String
    role         Role          @default(USER)
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    wishlists    Wishlist[]
    visitRecords VisitRecord[]
}

model Wishlist {
    id           Int        @id @default(autoincrement())
    userId       Int
    exhibitionId Int
    createdAt    DateTime   @default(now())
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

    @@unique([userId, exhibitionId])
    @@index([userId])
}

model VisitRecord {
    id           Int        @id @default(autoincrement())
    userId       Int
    exhibitionId Int
    visitedAt    DateTime   @default(now())
    note         String?
    rating       Int?
    photoUrl     String?
    isPublic     Boolean    @default(false)
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

    @@unique([userId, exhibitionId])
    @@index([userId])
}

model Notice {
    id          Int       @id @default(autoincrement())
    title       String
    body        String
    isPublished Boolean   @default(false)
    publishedAt DateTime?
    isPinned    Boolean   @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([isPublished, publishedAt, isPinned])
}
